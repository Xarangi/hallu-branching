.env
.venv/
__pycache__/
*__pycache__/
*.pyc
*.pyo
.pixi/
.vscode/

# Generated HalluHard evals — keep directory placeholders
halluhard/**/results/*.jsonl
halluhard/**/results/*.json
!halluhard/**/results/.gitkeep

!**/data/*.jsonl
**/data/*.json
!**/data/.gitkeep
*.html
.DS_Store

# Branching Hallucinations run artifacts (full runs stay local)
runs/*
!runs/.gitkeep
runs/*.log
